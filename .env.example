CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# "json" for structured logs
LOG_FORMAT=text
# Cache successful LLM query-understanding results (seconds; 0 disables)
LLM_CACHE_TTL_SECONDS=600
