DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://fashion_rec:change_me@localhost:5432/fashion_rec
EMBEDDING_DIM=768
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://localhost:11434
